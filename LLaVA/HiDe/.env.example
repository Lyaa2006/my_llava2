# Copy this file to .env and fill in your judge settings.
#
# The Math eval judge loads variables from:
# /mnt/lyaa/MCITlib/LLaVA/HiDe/.env

# Required for GLM-compatible chat completions.
GLM_API_KEY=your_glm_api_key_here

# Required if your provider exposes an OpenAI-compatible endpoint.
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Required model name for the judge.
GLM_MODEL=glm-4.7-flash
GLM_DISABLE_THINKING=1
JUDGE_NPROC=1
JUDGE_MAX_TOKENS=512
JUDGE_RETRY=3
JUDGE_TRUST_ENV_PROXY=0

# Optional judge-specific proxy settings.
# Prefer these over shell `export ...` so eval scripts can run standalone.
# When JUDGE_TRUST_ENV_PROXY=0, the judge ignores ambient HTTP_PROXY/HTTPS_PROXY.
# Set either JUDGE_PROXY once, or set protocol-specific values below.
# JUDGE_PROXY=http://127.0.0.1:7890
# JUDGE_HTTP_PROXY=http://127.0.0.1:7890
# JUDGE_HTTPS_PROXY=http://127.0.0.1:7890
# JUDGE_ALL_PROXY=socks5://127.0.0.1:7890

# Optional compatibility aliases. Usually not needed if the GLM_* vars above are set.
# OPENAI_API_KEY=your_glm_api_key_here
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions
# LOCAL_LLM=glm-4.7-flash
